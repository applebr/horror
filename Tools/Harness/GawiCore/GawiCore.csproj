<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unity 밖에서 게임 로직을 컴파일하기 위한 프로젝트.
    Unity와 같은 조건(netstandard2.0 API, C# 7.3)으로 컴파일해서
    Unity에서도 그대로 컴파일되는지 미리 검사한다.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <AssemblyName>GawiCore</AssemblyName>
    <RootNamespace>Gawi</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/Scripts/Engine/**/*.cs" />
    <Compile Include="../../../Assets/Scripts/Game/**/*.cs" />
  </ItemGroup>
</Project>
